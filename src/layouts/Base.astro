---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  keywords?: string;
  schema?: unknown;
  ogImage?: string;
  noindex?: boolean;
}
const SITE = 'https://doccheck.example';
const {
  title,
  description = 'DocCheck is a free photo and signature resizer — check photo size and signature size, automatically fix, verify and download for SSC, UPSC, IBPS, RRB and passport uploads.',
  canonical,
  keywords,
  schema,
  ogImage = `${SITE}/og-image.svg`,
  noindex = false,
} = Astro.props;
import '../styles/global.css';
// Avoid "Title | DocCheck | DocCheck" duplication: pages that already include branding use their title as-is.
const fullTitle = /doccheck/i.test(title) ? title : `${title} | DocCheck`;
const canonicalUrl = canonical ?? `${SITE}${Astro.url.pathname}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>try{var t=localStorage.getItem('docheck-theme')||'system';var d=(t==='system')?(window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):t;document.documentElement.dataset.theme=d;}catch(e){}</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="DocCheck" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#1b4f9c" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231b4f9c'/%3E%3Cpath d='M9 16.5l5 5 9-11' stroke='white' stroke-width='3.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Public+Sans:wght@400;600;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="ambient" aria-hidden="true">
      <svg class="ambient-doc" viewBox="0 0 460 620" focusable="false">
        <g fill="none" stroke="var(--authority)" stroke-opacity="0.55" stroke-width="2">
          <rect x="60" y="30" width="300" height="420" rx="6"/>
          <rect x="90" y="60" width="110" height="130" rx="3"/>
          <path d="M220 70h110M220 95h90M220 120h100M220 145h80" stroke-width="6" stroke-linecap="round"/>
          <path d="M90 230h240M90 260h200M90 290h220" stroke-width="6" stroke-linecap="round"/>
          <path d="M60 30v-12M90 30v-12M120 30v-12M150 30v-12M180 30v-12M210 30v-12M240 30v-12M270 30v-12M300 30v-12M330 30v-12M360 30v-12M60 60h-12M60 110h-12M60 160h-12M60 210h-12M60 260h-12M60 310h-12M60 360h-12M60 410h-12" stroke-width="1.5"/>
          <circle cx="330" cy="400" r="22"/>
          <path d="M320 400l7 7 14-15" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 480h60M20 480v60M400 60h-60M400 60v-60" stroke-width="1.5"/>
        </g>
        <g fill="var(--authority)" fill-opacity="0.55" font-family="monospace" font-size="13" letter-spacing="3">
          <text x="210" y="14" text-anchor="middle">WIDTH</text>
          <text x="38" y="240" text-anchor="middle" transform="rotate(-90 38 240)">HEIGHT</text>
          <text x="90" y="480">FORMAT · JPG</text>
          <text x="90" y="502">SIZE · KB</text>
        </g>
      </svg>
    </div>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
