---
import Base from '../../layouts/Base.astro';
import requirements from '../../data/requirements.json';

export async function getStaticPaths() {
  return requirements.map((r) => ({ params: { slug: r.slug }, props: { req: r } }));
}

const { req } = Astro.props;
const badge = req.status === 'verified' ? 'verified' : req.status === 'known_discrepancy' ? 'see note' : 'needs recheck';
const sizeText = req.min_kb != null || req.max_kb != null
  ? `${req.min_kb ?? '…'}–${req.max_kb ?? '…'} KB`
  : 'as per official notification';
const dimsText = req.width != null && req.height != null ? `, ${req.width} × ${req.height} ${req.unit}` : '';
const pageTitle = `${req.form_name} ${req.document_type} Size (${sizeText}${dimsText}) — Checker & Resizer`;
const pageDesc = `Check ${req.form_name} ${req.document_type} size (${sizeText}${dimsText}, ${(req.format || []).join('/') || 'see portal'}). Run the photo and signature checker, auto-fix, verify and download — in your browser.`;
const examLink = req.form_name.startsWith('SSC')
  ? '/ssc-photo-and-signature-resizer/'
  : req.form_name.startsWith('UPSC')
    ? '/upsc-photo-and-signature-resizer/'
    : req.form_name.startsWith('IBPS')
      ? '/ibps-photo-and-signature-resizer/'
      : req.form_name.startsWith('RRB')
        ? '/rrb-photo-and-signature-resizer/'
        : req.form_name.includes('Passport')
          ? '/passport-photo-resizer/'
          : '/exam-photo-and-signature-resizer/';
const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.exampicfix.in/' },
      { '@type': 'ListItem', position: 2, name: 'Requirements', item: 'https://www.exampicfix.in/requirements/' },
      { '@type': 'ListItem', position: 3, name: `${req.form_name} ${req.document_type}`, item: `https://www.exampicfix.in/requirements/${req.slug}/` },
    ],
  },
];
---
<Base title={pageTitle} description={pageDesc} canonical={`https://www.exampicfix.in/requirements/${req.slug}/`} schema={pageSchema}>
  <nav aria-label="Breadcrumb" class="fineprint"><a href="/">Home</a> / <a href="/requirements/">Requirements</a> / {req.form_name} {req.document_type}</nav>
  <h1>{req.form_name} — {req.document_type}: size, dimensions, format</h1>
  <p><span class={`badge ${req.status}`}>{badge}</span></p>

  <div class="report" role="table" aria-label={`${req.form_name} ${req.document_type} requirements`}>
    <div class="report-head" aria-hidden="true"><span>Requirement</span><span>Value</span><span></span></div>
    <div id="ledgerBody">
      {req.min_kb != null && <div class="report-row info"><div class="vals"><span class="prop">MINIMUM SIZE</span><div class="actual num">{req.min_kb} KB</div></div><span></span></div>}
      {req.max_kb != null && <div class="report-row info"><div class="vals"><span class="prop">MAXIMUM SIZE</span><div class="actual num">{req.max_kb} KB</div></div><span></span></div>}
      {req.width != null && <div class="report-row info"><div class="vals"><span class="prop">DIMENSIONS</span><div class="actual num">{req.width} × {req.height} {req.unit}</div></div><span></span></div>}
      {req.format?.length > 0 && <div class="report-row info"><div class="vals"><span class="prop">FORMAT</span><div class="actual num">{req.format.join(' / ')}</div></div><span></span></div>}
      {req.background_rule && <div class="report-row info"><div class="vals"><span class="prop">BACKGROUND</span><div class="actual">{req.background_rule}</div></div><span></span></div>}
      {req.special_rules && <div class="report-row info"><div class="vals"><span class="prop">SPECIAL RULES</span><div class="actual">{req.special_rules}</div></div><span></span></div>}
    </div>
  </div>

  <div class={`source-card${req.status === 'needs_recheck' ? ' recheck' : ''}`}>
    <div class="s-label">{req.status === 'needs_recheck' ? 'UNVERIFIED — NEEDS RECHECK' : 'OFFICIAL SOURCE — VERIFIED REQUIREMENT'}</div>
    <dl>
      <dt>Source</dt><dd>{req.official_source}</dd>
      <dt>Last verified</dt><dd>{req.verified_date ?? 'Not yet verified — marked needs recheck'}</dd>
      {req.status === 'needs_recheck' && <><dt>Note</dt><dd>This record is not yet verified against a current official source. Use the live portal as the authority.</dd></>}
    </dl>
  </div>

  {req.status === 'known_discrepancy' && (
    <div class="discrepancy">
      <div class="s-label">⚠ SOURCE DISCREPANCY</div>
      <p>Two official references list different values for this requirement.</p>
      <p>{req.discrepancy_note}</p>
      <p>Recommendation: follow the requirement shown on the live application portal when available.</p>
    </div>
  )}

  <p><a class="btn-primary" href="/#check" style="display:inline-block;width:auto;text-decoration:none;padding:12px 26px;">Check my file now</a></p>
  <p class="fineprint">Meets the published requirements we verified as of {req.verified_date ?? 'an unverified date'}. The live portal is the final authority — never a guarantee of acceptance.</p>
  <div class="prose">
    <h2>Check and resize this file</h2>
    <p>Open the <a href="/#check">photo and signature resizer</a>, select <strong>{req.form_name} — {req.document_type}</strong>, and upload your file. The photo and signature checker compares KB size, dimensions and format, fixes supported issues automatically, verifies the result and lets you download it. Related: <a href={examLink}>exam resizer for this form</a> · <a href="/">home-page photo and signature resizer</a>.</p>
  </div>
</Base>
