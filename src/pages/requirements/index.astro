---
import Base from '../../layouts/Base.astro';
import requirements from '../../data/requirements.json';

const groups = [
  { id: 'exam', label: 'Exams' },
  { id: 'identity_document', label: 'Identity Documents' },
  { id: 'bank_kyc', label: 'Bank & KYC' },
];
---
<Base title="Exam Photo Requirements — SSC, UPSC, IBPS, RRB, Passport Sizes | DocCheck" description="Browse sourced exam photo requirements and signature sizes for SSC, UPSC, IBPS, RRB, passport, PAN, KYC. Check, auto-fix, verify and download each file in your browser." canonical="https://doccheck.example/requirements/">
  <nav aria-label="Breadcrumb" class="fineprint"><a href="/">Home</a> / Requirements</nav>
  <h1>Exam Photo Requirements & Signature Sizes</h1>
  <p class="lede">Every published requirement we check against, with its official source and verification date. Pick one to check your file with the <a href="/#check">photo and signature resizer</a>.</p>
  {groups.map((g) => (
    <>
      <p class="refgroup">{g.label}</p>
      <ul class="reflist">
        {requirements.filter((r) => r.category === g.id).map((r) => (
          <li><a href={`/requirements/${r.slug}/`}><span>{r.form_name} — {r.document_type}</span><span class={`badge ${r.status}`}>{r.status === 'verified' ? 'verified' : r.status === 'known_discrepancy' ? 'see note' : 'needs recheck'}</span></a></li>
        ))}
      </ul>
    </>
  ))}
</Base>
