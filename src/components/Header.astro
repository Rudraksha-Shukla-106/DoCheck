---
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="DOCHECK home">
      <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="6" fill="#1b4f9c"/><path d="M9 16.5l5 5 9-11" stroke="white" stroke-width="3.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      DOCHECK
    </a>
    <nav class="mainnav" aria-label="Main">
      <a href="/#check">Check File</a>
      <a href="/requirements/">Requirements</a>
      <a href="/how-it-works/">How It Works</a>
      <div class="nav-drop" id="toolsDrop">
        <button type="button" class="nav-drop-btn" aria-haspopup="true" aria-expanded="false" aria-controls="toolsMenu">Tools <span class="caret" aria-hidden="true">▾</span></button>
        <div class="nav-drop-panel" id="toolsMenu" role="menu" aria-label="Tools">
          <a href="/resize-image-online/" role="menuitem">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
            <span class="td-text"><strong>Custom Image Resizer</strong><small>Resize by size, % or KB</small></span>
          </a>
        </div>
      </div>
    </nav>
    <div class="theme-switch" role="group" aria-label="Color theme">
      <button type="button" data-theme-set="light" aria-pressed="false" title="Light theme" aria-label="Light theme">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button type="button" data-theme-set="system" aria-pressed="true" title="System theme" aria-label="System theme">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3v18" /><path d="M12 3a9 9 0 010 18z" fill="currentColor" stroke="none"/></svg>
      </button>
      <button type="button" data-theme-set="dark" aria-pressed="false" title="Dark theme" aria-label="Dark theme">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z"/></svg>
      </button>
    </div>
    <span class="env-badge">Client-side</span>
  </div>
</header>
<script>
  const buttons = Array.from(document.querySelectorAll('[data-theme-set]'));
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  function resolve(stored) {
    if (stored === 'light' || stored === 'dark') return stored;
    return media.matches ? 'dark' : 'light';
  }
  function apply(stored) {
    document.documentElement.dataset.theme = resolve(stored);
    buttons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.themeSet === stored ? 'true' : 'false'));
  }
  let current = 'system';
  try { current = localStorage.getItem('docheck-theme') || 'system'; } catch (e) { /* private mode */ }
  apply(current);
  buttons.forEach((b) => b.addEventListener('click', () => {
    current = b.dataset.themeSet;
    try { localStorage.setItem('docheck-theme', current); } catch (e) { /* private mode */ }
    apply(current);
  }));
  media.addEventListener('change', () => { if (current === 'system') apply('system'); });
  const drop = document.getElementById('toolsDrop');
  const dropBtn = drop ? drop.querySelector('.nav-drop-btn') : null;
  function setDrop(open) {
    if (!drop || !dropBtn) return;
    drop.classList.toggle('open', open);
    dropBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  if (drop && dropBtn) {
    dropBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      setDrop(!drop.classList.contains('open'));
    });
    document.addEventListener('click', (e) => {
      if (!drop.contains(e.target)) setDrop(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { setDrop(false); dropBtn.blur(); }
    });
    drop.addEventListener('focusout', (e) => {
      if (!drop.contains(e.relatedTarget)) setDrop(false);
    });
  }
</script>
